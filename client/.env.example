# ============================================================
# MediSecure Frontend – Environment Variables Template
# Copy this file to .env and fill in your values.
# All variables MUST start with VITE_ to be exposed to the browser.
# ============================================================

# Backend API server (must match server/.env PORT)
VITE_API_PORT=5001
VITE_API_BASE_URL=http://localhost:5001
VITE_API_PREFIX=/api

# Application identity
VITE_APP_NAME=MediSecure
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# LocalStorage keys for JWT token & user data
VITE_TOKEN_KEY=medisecure_token
VITE_USER_KEY=medisecure_user

# Network request timeout in milliseconds
VITE_REQUEST_TIMEOUT=15000
