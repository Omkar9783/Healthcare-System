{
  "name": "medisecure-healthcare-system",
  "version": "1.0.0",
  "private": true,
  "description": "MediSecure Healthcare Identity, QR, & Access Control System",
  "scripts": {
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server dev",
    "dev:client": "npm --prefix client dev",
    "build:client": "npm --prefix client build",
    "start:ai": "cd ai-document-service && venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:ai": "cd ai-document-service && PYTHONPATH=. venv/bin/pytest tests",
    "dev": "npm --prefix server start & npm --prefix client dev"
  }
}
